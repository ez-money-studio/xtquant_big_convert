# coding: utf-8
# Big QMT bridge -- local environment template.
#
# Copy to a profile file and fill in the real values:
#     .env.dev    simulated / paper account
#     .env.prod   live account
# Both are gitignored; only this template is committed.
#
# Pick a profile with `set BIGQMT_ENV=dev` (or BIGQMT_ENV=prod), or point at a
# file directly with BIGQMT_ENV_FILE=D:\path\to\.env.prod. With nothing set the
# loader defaults to dev.
#
# Read by: `python -m bigqmt_signal_trader.env_config --show` (inspect),
# `--write` (generate the two config .py files), and automatically on import of
# bigqmt_signal_trader.xtquant_compat.

# ---------------------------------------------------------------- profile
# Optional: pin the profile from inside the file itself.
# BIGQMT_ENV=dev

# ---------------------------------------------------------------- account
# 资金账号. Must match the account QMT is logged into.
BIGQMT_ACCOUNT_ID=
# STOCK / CREDIT / FUTURE / STOCK_OPTION / HUGANGTONG / SHENGANGTONG
# A list is allowed when one account trades several books, e.g.
# BIGQMT_ACCOUNT_TYPE=["STOCK", "HUGANGTONG"]
BIGQMT_ACCOUNT_TYPE=STOCK

# ---------------------------------------------------------------- transport
# zmq (same machine, no extra service) or redis (needs a Redis server).
BIGQMT_RPC_TRANSPORT=zmq
# Where the QMT terminal runs. Use 127.0.0.1 for a same-host setup; a remote
# host also makes the server bind 0.0.0.0, so restrict the port with a firewall.
BIGQMT_ZMQ_HOST=127.0.0.1
# Leave empty to derive the port from the account id (15560 + id % 100).
BIGQMT_ZMQ_PORT=

# ---------------------------------------------------------------- redis
# Only used when BIGQMT_RPC_TRANSPORT=redis.
BIGQMT_REDIS_HOST=127.0.0.1
BIGQMT_REDIS_PORT=6379
BIGQMT_REDIS_DB=5
BIGQMT_REDIS_USERNAME=
BIGQMT_REDIS_PASSWORD=

# ---------------------------------------------------------------- paths
# QMT install directory and its python subdirectory (NOT bin.x64).
BIGQMT_QMT_INSTALL_DIR=
BIGQMT_QMT_PYTHON_DIR=
# Where the generated client config goes -- the directory you run scripts from.
BIGQMT_CLIENT_DIR=

# ---------------------------------------------------------------- server switch
# Remote order/cancel. Off means the bridge only answers queries. Turning it on
# lets ANY program that can reach the transport place and cancel real orders.
BIGQMT_ALLOW_ORDER_METHODS=false

# ---------------------------------------------------------------- qmt terminal login
# Used by qmt_launcher to restart/log in the terminal. Kept out of argv and out
# of generated config files on purpose -- this file is the only place it lives.
BIGQMT_LOGIN_USER=
BIGQMT_LOGIN_PASSWORD=

# ---------------------------------------------------------------- optional tuning
# RPC call timeout on the client, seconds.
BIGQMT_RPC_TIMEOUT_SECONDS=30
# Client-side local market-data cache directory. Empty -> ~/.bigqmt_cache
BIGQMT_LOCAL_CACHE_DIR=
# FormulaServer read fast path (127.0.0.1:58600). 1 = on, 0 = off.
BIGQMT_FORMULA_ENABLED=1
